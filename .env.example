# Postgres
DATABASE_URL=postgresql://pk_user:pk_password@localhost:5432/paper_killer
DATABASE_SCHEMA=auth_schema

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (Auth Service)
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Service URLs (for inter-service calls)
AUTH_SERVICE_URL=http://localhost:8001
WORKFLOW_SERVICE_URL=http://localhost:8003

# File uploads (Form Service)
UPLOAD_DIR=./uploads

# OCR — Gemini vision (Form Service). Use gemini-2.5-flash (gemini-2.0-flash is retiring).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/auth/oauth/google/callback
